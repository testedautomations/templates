    {
      "id": 2,
      "module": "google-docs:createADocumentFromTemplate",
      "version": 1,
      "parameters": {},
      "mapper": {
        "from": "drive",
        "name": "Invoice {{1.`0`}}",
        "select": "dropdown",
        "document": "/YOUR_FOLDER_ID/YOUR_TEMPLATE_DOC_ID",
        "folderId": "/YOUR_FOLDER_ID",
        "requests": {
          "date": "{{1.`5`}}",
          "item": "{{1.`3`}}",
          "amount": "{{1.`4`}}",
          "invoice_no": "{{1.`0`}}",
          "client_name": "{{1.`1`}}",
          "client_email": "{{1.`2`}}"
        },
        "destination": "drive"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:google",
            "label": "Connection",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "select",
            "type": "select",
            "label": "Create a Document from a Template",
            "required": true,
            "validate": {
              "enum": [
                "map",
                "dropdown"
              ]
            }
          },
          {
            "name": "name",
            "type": "text",
            "label": "Title",
            "required": true
          },
          {
            "name": "destination",
            "type": "select",
            "label": "New Drive Location",
            "required": true,
            "validate": {
              "enum": [
                "drive",
                "share",
                "team"
              ]
            }
          },
          {
            "name": "from",
            "type": "select",
            "label": "Choose a Drive",
            "required": true,
            "validate": {
              "enum": [
                "drive",
                "share",
                "team"
              ]
            }
          },
          {
            "name": "document",
            "type": "file",
            "label": "Document ID",
            "required": true
          },
          {
            "name": "requests",
            "spec": [
              {
                "name": "invoice_no",
                "type": "any"
              },
              {
                "name": "date",
                "type": "any"
              },
              {
                "name": "client_name",
                "type": "any"
              },
              {
                "name": "client_email",
                "type": "any"
              },
              {
                "name": "item",
                "type": "any"
              },
              {
                "name": "amount",
                "type": "any"
              }
            ],
            "type": "collection",
            "label": "Values"
          },
          {
            "name": "folderId",
            "type": "folder",
            "label": "New Document's Location",
            "required": true
          }
        ]
      }
    },
    {
      "id": 3,
      "module": "google-docs:exportADocument",
      "version": 1,
      "parameters": {},
      "mapper": {
        "document": "{{2.id}}",
        "mimeType": "application/pdf",
        "destination": "drive"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
