    {
      "id": 8,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "filter": null,
      "mapper": {
        "name": "mime",
        "value": "To: {{1.`2`}}{{newline}}Subject: Invoice {{1.`0`}}{{newline}}MIME-Version: 1.0{{newline}}Content-Type: multipart/mixed; boundary=\"invb\"{{newline}}{{newline}}--invb{{newline}}Content-Type: text/plain; charset=utf-8{{newline}}{{newline}}Hi {{1.`1`}},{{newline}}{{newline}}Your invoice {{1.`0`}} for USD {{1.`4`}} is attached.{{newline}}{{newline}}Thank you!{{newline}}--invb{{newline}}Content-Type: application/pdf{{newline}}Content-Transfer-Encoding: base64{{newline}}Content-Disposition: attachment; filename=\"{{1.`0`}}.pdf\"{{newline}}{{newline}}{{base64(3.data)}}{{newline}}--invb--"
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
