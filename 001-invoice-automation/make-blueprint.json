      "version": 4,
      "parameters": {},
      "mapper": {
        "url": "/v1/users/me/messages/send",
        "body": "{\"raw\":\"{{replace(replace(base64(8.mime); \"+\"; \"-\"); \"/\"; \"_\")}}\"}",
        "method": "POST",
