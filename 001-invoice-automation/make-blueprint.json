            "label": "Headers"
          },
          {
            "name": "qs",
            "spec": {
              "name": "value",
              "spec": [
                {
                  "name": "key",
                  "type": "text",
                  "label": "Key"
                },
                {
                  "name": "value",
                  "type": "text",
                  "label": "Value"
                }
              ],
              "type": "collection",
              "label": "Parameter"
            },
            "type": "array",
            "label": "Query string"
          },
          {
            "name": "body",
            "type": "any",
            "label": "Body"
          }
        ]
      },
      "onerror": [
