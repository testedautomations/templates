    {
      "id": 6,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "filter": {
        "name": "hot leads only",
        "conditions": [
          [
            {
              "a": "{{1.budget}}",
              "b": "over $2,000",
              "o": "text:equal"
            }
          ]
        ]
      },
      "mapper": {
        "name": "mime",
        "scope": "roundtrip",
        "value": "To: YOUR_EMAIL_ADDRESS{{newline}}Subject: New hot lead (row {{1.row}}){{newline}}MIME-Version: 1.0{{newline}}Content-Type: text/plain; charset=utf-8{{newline}}{{newline}}Name: {{1.name}}{{newline}}Email: {{1.email}}{{newline}}Company: {{1.company}}{{newline}}Budget: {{1.budget}}{{newline}}{{newline}}{{1.message}}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        },
        "expect": [
          {
            "name": "name",
            "type": "text",
            "label": "Variable name",
            "required": true
          },
          {
            "name": "value",
            "type": "any",
            "label": "Variable value"
          }
        ],
        "interface": [
          {
            "name": "mime",
            "type": "any",
            "label": "mime"
          }
        ]
      }
    },
    {
      "id": 4,
      "module": "google-email:makeAnApiCall",
      "version": 4,
      "parameters": {},
      "mapper": {
        "url": "/v1/users/me/messages/send",
        "body": "{\"raw\":\"{{replace(replace(base64(6.mime); \"+\"; \"-\"); \"/\"; \"_\")}}\"}",
        "method": "POST",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:google-email",
            "label": "Connection",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "url",
            "type": "text",
            "label": "URL",
            "required": true
          },
          {
            "name": "method",
            "type": "select",
            "label": "Method",
            "required": true,
            "validate": {
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ]
            }
          },
          {
            "name": "headers",
            "spec": {
              "name": "value",
              "spec": [
                {
                  "name": "key",
                  "type": "text",
                  "label": "Key"
                },
                {
                  "name": "value",
                  "type": "text",
                  "label": "Value"
                }
              ],
              "type": "collection",
              "label": "Header"
            },
            "type": "array",
            "label": "Headers"
          },
          {
            "name": "qs",
            "spec": {
              "name": "value",
              "spec": [
                {
                  "name": "key",
                  "type": "text",
                  "label": "Key"
                },
                {
                  "name": "value",
                  "type": "text",
                  "label": "Value"
                }
              ],
              "type": "collection",
              "label": "Parameter"
            },
            "type": "array",
            "label": "Query string"
          },
          {
            "name": "body",
            "type": "any",
            "label": "Body"
          }
        ]
      }
    },
    {
      "id": 7,
      "module": "telegram:SendReplyMessage",
      "version": 1,
      "parameters": {},
      "mapper": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "New hot lead (row {{1.row}})\nName: {{1.name}}\nEmail: {{1.email}}\nCompany: {{1.company}}\nBudget: {{1.budget}}\n{{1.message}}",
        "messageThreadId": "",
        "parseMode": "",
        "replyToMessageId": "",
        "replyMarkupAssembleType": "reply_markup_enter",
        "replyMarkup": ""
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:telegram",
            "label": "Connection",
            "required": true
          }
        ]
      }
